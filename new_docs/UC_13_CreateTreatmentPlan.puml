@startuml UC_13_CreateTreatmentPlan
title UC_UC_16: Tạo phác đồ điều trị

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor Default
    BorderColor Navy
    ArrowColor Navy
}

actor "Bác sĩ" as D

rectangle "Nghiệp vụ Bác sĩ" {
    usecase "Khởi tạo Phác đồ" as UC1
    usecase "Thêm các bước điều trị" as UC2
    usecase "Lưu Phác đồ" as UC4
    
    UC1 ..> UC2 : <<include>>
    UC2 ..> UC4 : <<include>>
}

D --> UC1

@enduml
