@startuml UC_08_MakePayment
title UC_08: Thanh toán

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor Default
    BorderColor Navy
    ArrowColor Navy
}

actor "Bệnh nhân" as P

rectangle "Thanh toán" {
    usecase "Xem hóa đơn chờ thanh toán" as UC1
    usecase "Chọn phương thức thanh toán" as UC2
    usecase "Xử lý giao dịch qua cổng" as UC3
    usecase "Cập nhật trạng thái hóa đơn" as UC4
    usecase "đánh giá dịch vụ" as UC12
    
    UC1 ..> UC2 : <<include>>
    UC2 ..> UC3 : <<include>>
    UC3 ..> UC4 : <<include>>
    UC4 ..> UC12 : <<extend>>
}

P --> UC1

@enduml
