# ===== IDE & EDITOR FILES =====
.idea/
.vscode/
*.swp
*.swo
*~

# ===== OS GENERATED FILES =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===== ANDROID PROJECT =====
# Built application files
mobile_android/*.apk
mobile_android/*.aar

# Files for the ART/Dalvik VM
mobile_android/*.dex

# Java class files
mobile_android/*.class

# Generated files
mobile_android/bin/
mobile_android/gen/
mobile_android/out/
mobile_android/release/

# Gradle files
mobile_android/.gradle/
mobile_android/build/

# Local configuration file (sdk path, etc)
mobile_android/local.properties

# Proguard folder generated by Eclipse
mobile_android/proguard/

# Log Files
mobile_android/*.log

# Android Studio Navigation editor temp files
mobile_android/.navigation/

# Android Studio captures folder
mobile_android/captures/

# IntelliJ
mobile_android/*.iml
mobile_android/.idea/workspace.xml
mobile_android/.idea/tasks.xml
mobile_android/.idea/gradle.xml
mobile_android/.idea/assetWizardSettings.xml
mobile_android/.idea/dictionaries
mobile_android/.idea/libraries
mobile_android/.idea/jarRepositories.xml
mobile_android/.idea/compiler.xml
mobile_android/.idea/runConfigurations.xml

# Keystore files
mobile_android/*.jks
mobile_android/*.keystore

# External native build folder generated in Android Studio 2.2 and later
mobile_android/.externalNativeBuild
mobile_android/.cxx/

# Google Services (e.g. APIs or Firebase)
mobile_android/google-services.json

# Freeline
mobile_android/freeline.py
mobile_android/freeline/
mobile_android/freeline_project_description.json

# fastlane
mobile_android/fastlane/report.xml
mobile_android/fastlane/Preview.html
mobile_android/fastlane/screenshots
mobile_android/fastlane/test_output
mobile_android/fastlane/readme.md

# Version control
mobile_android/.versionName

# lint
mobile_android/lint/intermediates/
mobile_android/lint/generated/
mobile_android/lint/outputs/
mobile_android/lint/tmp/

# Android Profiling
mobile_android/*.hprof

