@startuml AC_02_ForgotPassword
title Activity Diagram: AC_02 Quên mật khẩu

start
:Người dùng chọn Quên mật khẩu;
:Nhập số điện thoại đăng ký;
:Xác nhận số điện thoại;
if (Số điện thoại tồn tại?) then (Có)
    :Hệ thống gửi mã OTP qua SMS;
    :Người dùng nhập mã OTP;
    if (Mã OTP hợp lệ?) then (Có)
        :Nhập mật khẩu mới và xác nhận;
        :Hệ thống cập nhật mật khẩu mới;
        :Chuyển hướng về trang đăng nhập;
    else (Không)
        :Báo lỗi OTP không hợp lệ hoặc hết hạn;
    endif
else (Không)
    :Báo lỗi số điện thoại không tồn tại;
endif
stop
@enduml