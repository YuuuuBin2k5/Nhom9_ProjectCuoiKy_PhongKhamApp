@startuml UC_06_CheckIn
title UC_06: Check-in phòng khám

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor Default
    BorderColor Navy
    ArrowColor Navy
}

actor "Bệnh nhân" as P

rectangle "Quản lý hàng đợi" {
    usecase "Quét QR / Nhập mã" as UC1
    usecase "Xác thực lịch hẹn" as UC2
    usecase "Tạo lịch khẩn cấp\n(Walk-in)" as UC3
    usecase "Vào hàng đợi" as UC7
    
    UC1 ..> UC2 : <<include>>
    UC2 ..> UC3 : <<extend>>
    UC2 ..> UC7 : <<include>>
    UC3 ..> UC7 : <<include>>
}

P --> UC1

@enduml
