@startuml
title Activity Diagram: AC_23 Xem trạng thái Hàng đợi (Dành cho Bệnh nhân)

start
:Truy cập tính năng "Số thứ tự của tôi";

if (Đã có lịch hẹn/đã check-in?) then (Đã có số)
    :Hệ thống xác định Phòng khám đang chờ;
    :Hiển thị thông tin Hàng đợi thời gian thực;

    partition "Thông tin hiển thị" {
        :Số thứ tự đang được gọi (Serving);
        :Số thứ tự của bản thân (My Number);
        :Số người còn lại phía trước;
    }
else (Chưa có số)
    :Thông báo: "Bạn hiện không có lịch khám trong hàng đợi";
    :Gợi ý đăng ký khám hoặc liên hệ Lễ tân;
endif

stop
@enduml