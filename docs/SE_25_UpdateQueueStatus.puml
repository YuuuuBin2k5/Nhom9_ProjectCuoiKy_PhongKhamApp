@startuml SE_25_UpdateQueueStatus
title Sequence Diagram: SE_25 Cập nhật trạng thái Hàng đợi
actor "Bác sĩ/Hệ thống" as System
participant "View\n(QueueActivity)" as View
participant "CheckInController" as Controller
participant "QueueEventService" as Service
participant "CheckInQueueRepository" as Repo
database "PostgreSQL" as DB

System -> View: Hoàn tất / Bỏ qua lượt
activate View
View -> Controller: updateQueueStatus(queueId, status)
activate Controller
Controller -> Service: changeQueueStatus(queueId, status)
activate Service
Service -> Repo: findById(queueId)
Service -> DB: UPDATE check_in_queue SET status=?
Service --> Controller: success
Controller --> View: 200 OK
View --> System: Làm mới màn hình queue
deactivate View
@enduml