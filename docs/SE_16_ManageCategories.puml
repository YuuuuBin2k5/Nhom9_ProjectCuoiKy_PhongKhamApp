@startuml SE_16_ManageCategories
title Sequence Diagram: SE_16 Quản lý danh mục dịch vụ
actor "Admin" as Admin
participant "View\n(AdminCategoryActivity)" as View
participant "AdminServiceController" as Controller
participant "AdminServiceManagementService" as Service
participant "ServiceCategoryRepository" as Repo
database "PostgreSQL" as DB

Admin -> View: Nhập tên danh mục & Lưu
activate View
View -> Controller: createCategory(categoryReq)
activate Controller
Controller -> Service: addCategory(categoryReq)
activate Service
Service -> Repo: save(ServiceCategory)
Repo -> DB: INSERT INTO service_category...
DB --> Repo: success
Service --> Controller: CategoryResponse
Controller --> View: 200 OK
View --> Admin: Cập nhật danh sách mới
deactivate View
@enduml