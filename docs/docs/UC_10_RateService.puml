@startuml UC_10_RateService
title UC_10: Đánh giá dịch vụ

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor Default
    BorderColor Navy
    ArrowColor Navy
}

actor "Bệnh nhân" as P

rectangle "Đánh giá" {
    usecase "Chọn dịch vụ đã hoàn thành" as UC1
    usecase "Đánh giá số Sao (Rating)" as UC2
    usecase "Nhập nhận xét (Feedback)" as UC3
    usecase "Gửi Đánh giá" as UC4
    
    UC1 ..> UC2 : <<include>>
    UC1 ..> UC3 : <<extend>>
    UC2 ..> UC4 : <<include>>
}

P --> UC1

@enduml
