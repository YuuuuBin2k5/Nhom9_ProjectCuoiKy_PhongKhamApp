@startuml SE_05_BookAppointment
title Sequence Diagram: SE_05 Đặt lịch hẹn
actor "Bệnh nhân" as Patient
participant "View\n(BookAppointmentActivity)" as View
participant "AppointmentController" as Controller
participant "AppointmentService" as Service
participant "AppointmentRepository" as Repo
database "PostgreSQL" as DB

Patient -> View: Chọn Dịch vụ, Bác sĩ, Giờ & Nhấn Đặt
activate View
View -> Controller: bookAppointment(apptRequest)
activate Controller
Controller -> Service: createAppointment(req)
activate Service
Service -> DB: SELECT count(*) FROM appointment WHERE doctor_id=...
Service -> Repo: save(appointment)
activate Repo
Repo -> DB: INSERT INTO appointment...
DB --> Repo: success
Repo --> Service: savedEntity
deactivate Repo
Service --> Controller: AppointmentResponse
deactivate Service
Controller --> View: 200 OK
deactivate Controller
View --> Patient: Thông báo đặt lịch thành công
deactivate View
@enduml