@startuml UC_00_overall_system
scale 1.5
left to right direction
skinparam packageStyle rectangle

skinparam nodesep 12
skinparam ranksep 25
skinparam usecase {
    BorderColor Navy
    ArrowColor Navy
}
skinparam actor {
    BorderColor Navy
}

' ======================
' Actors
' ======================
actor "Admin" as a
actor "Doctor" as d
actor "Patient" as p

a -[hidden]down- d
d -[hidden]down- p

rectangle "Dental Clinic Management System" {

    ' ======================
    package "1. Xác thực" {
        usecase "Đăng nhập" as UC_01
        usecase "Quên mật khẩu" as UC_02
        usecase "Đăng ký tài khoản" as UC_28
    }

    ' ======================
    package "2. Bệnh nhân" {
        usecase "Quản lý tài khoản" as UC_03
        usecase "Xem dịch vụ" as UC_04
        usecase "Đặt lịch khám" as UC_05
        usecase "Check-in phòng khám" as UC_06
        usecase "Theo dõi liệu trình" as UC_07
        usecase "Thanh toán" as UC_08
        usecase "Xem lịch sử khám" as UC_09
        usecase "Đánh giá dịch vụ" as UC_10
    }

    ' ======================
    package "3. Bác sĩ" {
        usecase "Bắt đầu khám bệnh" as UC_11
        usecase "Xem bệnh án bệnh nhân" as UC_12
        usecase "Tạo phác đồ điều trị" as UC_13
        usecase "Ghi nhận kết quả khám" as UC_14
        usecase "Chuyển sang bước tiếp theo" as UC_15
        usecase "Điều chỉnh phác đồ điều trị" as UC_29
    }

    ' ======================
    package "4. Quản trị viên" {
        usecase "Quản lý danh mục" as UC_16
        usecase "Quản lý dịch vụ" as UC_17
        usecase "Quản lý bác sĩ" as UC_18
        usecase "Quản lý phòng khám" as UC_19
        usecase "Xem báo cáo doanh thu" as UC_20
        usecase "Quản lý hóa đơn" as UC_21
    }

    ' ======================
    package "5. Quản lý hàng đợi" {
        usecase "Tham gia hàng đợi" as UC_22
        usecase "Xem trạng thái hàng đợi" as UC_23
        usecase "Xử lý hàng đợi" as UC_24
        usecase "Cập nhật trạng thái hàng đợi" as UC_25
        usecase "Chuyển bệnh nhân giữa các phòng" as UC_26
        usecase "Loại bệnh nhân khỏi hàng đợi" as UC_27
    }
}

' ======================
' Actor interactions
' ======================

' Login chung
a --> UC_01
d --> UC_01
p --> UC_01

' Forgot password & Register (Patient only)
p --> UC_02
p --> UC_28

' Patient interactions
p --> UC_03
p --> UC_04
p --> UC_05
p --> UC_06
p --> UC_07
p --> UC_08
p --> UC_09
p --> UC_10

' Doctor interactions
d --> UC13
d --> UC_14
d --> UC_15
d --> UC_29
d --> UC_11
d --> UC_12

' Admin interactions
a --> UC_16
a --> UC_17
a --> UC_18
a --> UC_19
a --> UC_20
a --> UC_21

' Queue interactions
p --> UC_22
p --> UC_23

d --> UC_24
d --> UC_25
d --> UC_26

a --> UC_27

' ======================
' Relationships
' ======================

' Patient Rel
UC_06 ..> UC_22 : <<include>>
UC_22 ..> UC_23 : <<include>>
UC_08 ..> UC_10 : <<extend>>

' Doctor Rel
UC_24 ..> UC_11 : <<include>>
UC_24 ..> UC_25 : <<include>>
UC_14 ..> UC_15 : <<include>>

@enduml