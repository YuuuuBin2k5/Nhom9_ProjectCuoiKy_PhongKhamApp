@startuml
title Activity Diagram: AC_16 Quản lý danh mục dịch vụ

|Quản trị viên|
start
:Vào giao diện Quản lý danh mục;

if (Chọn hành động?) then (Thêm mới)
    :Nhập thông tin (Tên, mô tả);
    :Hệ thống kiểm tra trùng lặp;
    :Lưu danh mục mới;
elseif (Chỉnh sửa)
    :Chọn danh mục cần cập nhật;
    :Nhập thông tin thay đổi;
    :Cập nhật vào hệ thống;
else (Xóa)
    :Chọn danh mục muốn xóa;
    if (Danh mục đang chứa dịch vụ?) then (Có)
        :Hiển thị thông báo: "Không thể xóa danh mục đang hoạt động";
    else (Không)
        :Yêu cầu xác nhận xóa;
        :Xóa danh mục khỏi cơ sở dữ liệu;
    endif
endif

stop
