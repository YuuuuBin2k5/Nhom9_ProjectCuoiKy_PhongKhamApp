@startuml SE_09_ViewMedicalHistory
title Sequence Diagram: SE_09 Xem hồ sơ bệnh án cá nhân
actor "Bệnh nhân" as Patient
participant "View\n(MedicalRecordActivity)" as View
participant "PatientController" as Controller
participant "MedicalRecordService" as Service
participant "MedicalRecordRepository" as Repo
database "PostgreSQL" as DB

Patient -> View: Mở sổ khám bệnh
activate View
View -> Controller: getMedicalRecords(patientId)
activate Controller
Controller -> Service: getRecords(patientId)
activate Service
Service -> Repo: findByPatientId(patientId)
Repo -> DB: SELECT * FROM medical_record...
DB --> Repo: records
Repo --> Service: records
Service --> Controller: List<RecordResponse>
Controller --> View: 200 OK
View --> Patient: Hiển thị lịch sử khám
deactivate View
@enduml