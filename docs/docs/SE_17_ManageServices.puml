@startuml SE_17_ManageServices
title Sequence Diagram: SE_17 Quản lý Dịch vụ
actor "Admin" as Admin
participant "View\n(AdminServiceActivity)" as View
participant "AdminServiceController" as Controller
participant "AdminServiceManagementService" as Service
participant "ServiceRepository" as Repo
database "PostgreSQL" as DB

Admin -> View: Điền thông tin Dịch vụ & Lưu
activate View
View -> Controller: createService(serviceReq)
activate Controller
Controller -> Service: addService(serviceReq)
activate Service
Service -> Repo: save(Service)
Repo -> DB: INSERT INTO service...
DB --> Repo: success
Service --> Controller: ServiceResponse
Controller --> View: 200 OK
View --> Admin: Dịch vụ đã được tạo
deactivate View
@enduml