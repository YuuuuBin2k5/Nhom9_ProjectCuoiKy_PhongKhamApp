@startuml SE_20_ViewRevenueReports
title Sequence Diagram: SE_20 Xem Báo cáo doanh thu
actor "Admin" as Admin
participant "View\n(DashboardActivity)" as View
participant "InvoiceController" as Controller
participant "StatisticsService" as Service
participant "InvoiceRepository" as Repo
database "PostgreSQL" as DB

Admin -> View: Chọn khoảng thời gian
activate View
View -> Controller: getRevenueReport(startDate, endDate)
activate Controller
Controller -> Service: calculateRevenue(dates)
activate Service
Service -> Repo: sumTotalAmount(dates)
Repo -> DB: SELECT SUM(total_amount) FROM invoice...
DB --> Repo: total
Service --> Controller: RevenueReportResponse
Controller --> View: 200 OK
View --> Admin: Vẽ biểu đồ thống kê
deactivate View
@enduml