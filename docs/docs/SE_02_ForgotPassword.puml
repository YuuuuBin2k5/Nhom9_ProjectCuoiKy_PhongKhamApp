@startuml SE_02_ForgotPassword
title Sequence Diagram: SE_02 Quên mật khẩu
actor "Người dùng" as User
participant "View\n(ForgotPwActivity)" as View
participant "AuthController" as Controller
participant "OtpService" as Service
participant "UserRepository" as Repo
database "PostgreSQL" as DB

User -> View: Nhập SĐT & Gửi OTP
activate View
View -> Controller: requestOtp(phone)
activate Controller
Controller -> Service: generateAndSendOtp(phone)
activate Service
Service -> Repo: existsByPhone(phone)
Repo --> Service: true
Service -> DB: INSERT INTO otp_challenge...
Service --> Controller: success
Controller --> View: 200 OK
View --> User: Yêu cầu nhập OTP

User -> View: Nhập OTP & Mật khẩu mới
View -> Controller: resetPassword(otp, newPw)
Controller -> Service: verifyOtpAndReset(otp, newPw)
Service -> DB: SELECT * FROM otp_challenge...
Service -> DB: UPDATE users SET password=...
Service --> Controller: success
Controller --> View: 200 OK
View --> User: Reset thành công
deactivate Controller
deactivate View
@enduml