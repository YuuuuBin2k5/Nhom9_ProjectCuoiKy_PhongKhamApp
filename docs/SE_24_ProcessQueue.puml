@startuml SE_24_ProcessQueue
title Sequence Diagram: SE_24 Xử lý Hàng đợi chung
actor "Lễ tân" as Staff
participant "View\n(ReceptionActivity)" as View
participant "ReceptionController" as Controller
participant "QueueEventService" as Service
participant "CheckInQueueRepository" as Repo
database "PostgreSQL" as DB

Staff -> View: Phân luồng dòng khách
activate View
View -> Controller: assignToRoom(patientId, roomId)
activate Controller
Controller -> Service: distributeQueue(patientId, roomId)
activate Service
Service -> Repo: save(CheckInQueue instance)
Repo -> DB: INSERT INTO check_in_queue...
Service --> Controller: success
Controller --> View: 200 OK
View --> Staff: Báo xếp phòng thành công
deactivate View
@enduml