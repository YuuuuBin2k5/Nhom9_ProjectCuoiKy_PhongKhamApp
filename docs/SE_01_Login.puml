@startuml SE_01_Login
title Sequence Diagram: SE_01 Đăng nhập
actor "Người dùng" as User
participant "View\n(LoginActivity)" as View
participant "AuthController" as Controller
participant "AuthService" as Service
participant "UserRepository" as Repo
database "PostgreSQL" as DB

User -> View: Nhập thông tin & Submit
activate View
View -> Controller: login(loginRequest)
activate Controller
Controller -> Service: authenticate(username, password)
activate Service
Service -> Repo: findByUsername(username)
activate Repo
Repo -> DB: SELECT * FROM users
activate DB
DB --> Repo: User data
deactivate DB
Repo --> Service: userEntity
deactivate Repo
alt Sai mật khẩu / Không tồn tại
    Service --> Controller: throw AuthException
    Controller --> View: 401 Unauthorized
    View --> User: Báo lỗi
else Hợp lệ
    Service -> Service: generateJwtToken(user)
    Service --> Controller: AuthResponse(token)
    Controller --> View: 200 OK
    View --> User: Chuyển hướng Dashboard
end
deactivate Service
deactivate Controller
deactivate View
@enduml