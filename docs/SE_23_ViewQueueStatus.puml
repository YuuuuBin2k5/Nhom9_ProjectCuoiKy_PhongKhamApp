@startuml SE_23_ViewQueueStatus
title Sequence Diagram: SE_23 Xem trạng thái Hàng đợi
actor "User" as User
participant "View\n(QueueStatusActivity)" as View
participant "CheckInController" as Controller
participant "CheckInQueueService" as Service
participant "CheckInQueueRepository" as Repo
database "PostgreSQL" as DB

User -> View: Mở màn hình Hàng đợi
activate View
View -> Controller: getQueueStatus(roomId)
activate Controller
Controller -> Service: getQueueForRoom(roomId)
activate Service
Service -> Repo: findByRoomIdAndStatus(...)
Repo -> DB: SELECT * FROM check_in_queue...
DB --> Repo: listQueue
Service --> Controller: List<QueueResponse>
Controller --> View: 200 OK
View --> User: Cập nhật danh sách gọi số
deactivate View
@enduml