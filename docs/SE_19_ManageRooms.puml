@startuml SE_19_ManageRooms
title Sequence Diagram: SE_19 Quản lý Phòng khám
actor "Admin" as Admin
participant "View\n(AdminRoomActivity)" as View
participant "AdminRoomController" as Controller
participant "ClinicRoomService" as Service
participant "ClinicRoomRepository" as Repo
database "PostgreSQL" as DB

Admin -> View: Thêm / Sửa Phòng khám
activate View
View -> Controller: saveRoom(roomReq)
activate Controller
Controller -> Service: saveRoomData(roomReq)
activate Service
Service -> Repo: save(ClinicRoom)
Repo -> DB: INSERT INTO clinic_room...
DB --> Repo: success
Service --> Controller: RoomResponse
Controller --> View: 200 OK
View --> Admin: Đã lưu phòng khám
deactivate View
@enduml