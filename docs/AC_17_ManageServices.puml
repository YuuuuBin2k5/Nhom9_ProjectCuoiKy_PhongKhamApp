@startuml
title Activity Diagram: AC_17 Quản lý Dịch vụ (Service Management)

|Quản trị viên|
start
:Vào giao diện Quản lý Dịch vụ;
:Chọn một dịch vụ từ danh sách;

if (Chọn hành động?) then (Thêm/Sửa)
    :Thực hiện cập nhật thông tin;
    :Lưu vào hệ thống;
else (Xóa dịch vụ)
    if (Kiểm tra: Có trong Hóa đơn hoặc Cuộc hẹn?) then (Có tồn tại)
        :Hiển thị thông báo: "Dịch vụ đã có dữ liệu giao dịch";
        :Yêu cầu chuyển sang trạng thái "Ngưng hoạt động" thay vì xóa;
        if (Xác nhận ngưng hoạt động?) then (Đồng ý)
            :Cập nhật [Active = false];
            :Thông báo: "Đã ẩn dịch vụ khỏi danh sách sử dụng";
        else (Hủy)
            :Giữ nguyên trạng thái;
        endif
    else (Không tồn tại)
        :Hiển thị xác nhận xóa vĩnh viễn;
        if (Xác nhận xóa?) then (Đồng ý)
            :Xóa dịch vụ khỏi Cơ sở dữ liệu;
            :Thông báo: "Xóa thành công";
        else (Hủy)
            :Hủy tác vụ xóa;
        endif
    endif
endif

stop
@enduml