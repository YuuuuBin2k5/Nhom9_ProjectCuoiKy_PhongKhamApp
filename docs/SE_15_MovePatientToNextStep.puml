@startuml SE_15_MovePatientToNextStep
title Sequence Diagram: SE_15 Chuyển sang bước điều trị tiếp theo

actor "Bác sĩ" as Doctor
participant "View\n(DoctorWorkflowActivity)" as View
participant "TreatmentPlanController" as PlanController
participant "TreatmentPlanService" as PlanService
participant "CheckInQueueService" as QueueService
participant "TreatmentPlanStepRepository" as StepRepo
database "PostgreSQL" as DB

Doctor -> View: Nhấn "Chuyển bước tiếp theo"
activate View
View -> PlanController: moveToNextStep(planId, currentStepId)
activate PlanController

PlanController -> PlanService: completeCurrentAndStartNext(planId, currentStepId)
activate PlanService

PlanService -> StepRepo: findNextStep(planId)
activate StepRepo
StepRepo -> DB: SELECT * FROM treatment_plan_step WHERE sequence > current...
activate DB
DB --> StepRepo: nextStep
deactivate DB
StepRepo --> PlanService: nextStep
deactivate StepRepo

alt Nếu không còn bước tiếp theo
    PlanService -> DB: UPDATE treatment_plan SET status = 'COMPLETED'
    PlanService --> PlanController: PlanCompletedResponse
else Còn bước tiếp theo
    PlanService -> PlanService: update status of nextStep = 'IN_PROGRESS'
    PlanService -> StepRepo: save(nextStep)
    activate StepRepo
    StepRepo -> DB: UPDATE treatment_plan_step...
    activate DB
    DB --> StepRepo: success
    deactivate DB
    StepRepo --> PlanService: updatedNextStep
    deactivate StepRepo

    opt Nếu bước tiếp theo ở phòng khác
        PlanService -> QueueService: addToQueue(patientId, nextRoomId)
        activate QueueService
        QueueService -> DB: INSERT INTO check_in_queue...
        QueueService --> PlanService: newQueueEntry
        deactivate QueueService
    end
    PlanService --> PlanController: NextStepResponse(nextStep, roomAssigned)
end
deactivate PlanService

PlanController --> View: 200 OK (Response)
deactivate PlanController

View --> Doctor: Thay đổi giao diện cho bước tiếp theo
deactivate View
@enduml
