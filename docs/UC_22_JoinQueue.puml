@startuml UC_22_JoinQueue
title UC_22: Tham gia hàng đợi

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor Default
    BorderColor Navy
    ArrowColor Navy
}

actor "Bệnh nhân" as P

rectangle "Quản lý hàng đợi" {
    usecase "Tham gia hàng đợi" as UC1
    usecase "Tính toán độ ưu tiên" as UC2
    usecase "Xem danh sách bệnh nhân trong hàng đợi" as UC8
    
    UC1 ..> UC2 : <<include>>
    UC1 ..> UC8 : <<include>>
}

P --> UC1

note bottom of UC2
  Priority:
  1. On-time
  2. Late < 15m
  3. Walk-in / Late > 30m
end note

@enduml
