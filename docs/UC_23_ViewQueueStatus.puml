@startuml UC_23_ViewQueueStatus
title UC_23: Xem trạng thái hàng đợi

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor Default
    BorderColor Navy
    ArrowColor Navy
}

actor "Bệnh nhân" as P

rectangle "Quản lý hàng đợi" {
    usecase "Tải dữ liệu hàng đợi" as UC1
    usecase "Ước tính thời gian chờ" as UC2
    usecase "Hiển thị trạng thái realtime" as UC3
    
    UC1 ..> UC2 : <<include>>
    UC2 ..> UC3 : <<include>>
}

P --> UC1

@enduml
