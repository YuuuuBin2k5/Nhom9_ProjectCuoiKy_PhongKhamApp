@startuml SE_18_ManageDoctors
title Sequence Diagram: SE_18 Quản lý Danh sách Bác sĩ
actor "Admin" as Admin
participant "View\n(AdminDoctorActivity)" as View
participant "AdminDoctorController" as Controller
participant "AdminDoctorService" as Service
participant "DoctorRepository" as Repo
database "PostgreSQL" as DB

Admin -> View: Nhập thông tin Bác sĩ mới
activate View
View -> Controller: createDoctor(doctorReq)
activate Controller
Controller -> Service: createNewDoctor(doctorReq)
activate Service
Service -> DB: INSERT INTO users (role='DOCTOR')...
Service -> Repo: save(Doctor)
Repo -> DB: INSERT INTO doctor...
DB --> Repo: success
Service --> Controller: DoctorResponse
Controller --> View: 200 OK
View --> Admin: Báo tạo thành công
deactivate View
@enduml