@startuml SE_13_CreateTreatmentPlan
title Sequence Diagram: SE_13 Tạo phác đồ điều trị

actor "Bác sĩ" as Doctor
participant "View\n(EmrActivity)" as View
participant "TreatmentPlanController" as Controller
participant "TreatmentPlanService" as Service
participant "TreatmentPlanRepository" as PlanRepo
participant "TreatmentPlanStepRepository" as StepRepo
database "PostgreSQL" as DB

Doctor -> View: Khám & Chọn "Tạo phác đồ điều trị"
activate View
View -> Controller: createTreatmentPlan(planRequest)
activate Controller

Controller -> Service: createPlanForPatient(planRequest)
activate Service

Service -> PlanRepo: save(TreatmentPlan)
activate PlanRepo
PlanRepo -> DB: INSERT INTO treatment_plan...
activate DB
DB --> PlanRepo: success
deactivate DB
PlanRepo --> Service: savedPlan
deactivate PlanRepo

loop Mỗi bước điều trị (Step) trong planRequest
    Service -> StepRepo: save(TreatmentPlanStep)
    activate StepRepo
    StepRepo -> DB: INSERT INTO treatment_plan_step...
    activate DB
    DB --> StepRepo: success
    deactivate DB
    StepRepo --> Service: savedStep
    deactivate StepRepo
end

Service --> Controller: TreatmentPlanResponse
deactivate Service

Controller --> View: 200 OK (TreatmentPlanResponse)
deactivate Controller

View --> Doctor: Hiển thị phác đồ vừa tạo
deactivate View
@enduml
