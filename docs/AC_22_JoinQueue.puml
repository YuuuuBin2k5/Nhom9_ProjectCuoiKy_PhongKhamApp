@startuml AC_22_JoinQueue
title AC-22: Tham gia hàng đợi (Join Queue)

start
:Đến phòng khám;
:Check-in (QR / nhập mã);

:Kiểm tra thông tin bệnh nhân;

if (Đã có liệu trình?) then (Yes)

    :Xác định bước tiếp theo;

    if (Quay lại phòng trước?) then (Yes)
        :Đánh dấu "Returning";
        :Ưu tiên = 1 (cao nhất);
    else (No)
        :Ưu tiên theo loại dịch vụ;
    endif

else (No)

    if (Có cuộc hẹn?) then (Yes)

        if (Đúng giờ?) then (Yes)
            :Ưu tiên = 2;
        else (No)
            if (Trễ < 15 phút?) then (Yes)
                :Ưu tiên = 3;
            else (No)
                :Ưu tiên = 5 (Trễ > 30 phút);
            endif
        endif

    else (No)
        :Walk-in;
        :Ưu tiên = 4;
    endif

endif

:Thêm vào hàng đợi;
:Sắp xếp theo (ưu tiên, thời gian check-in);

:Phát số thứ tự;
:Tính thời gian chờ;
:Hiển thị cho bệnh nhân;

stop
@enduml