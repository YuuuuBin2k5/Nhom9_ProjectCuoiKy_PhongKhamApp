@startuml SE_12_ViewPatientMedicalHistory
title Sequence Diagram: SE_12 Bác sĩ xem bệnh án lịch sử của bệnh nhân
actor "Bác sĩ" as Doctor
participant "View\n(EmrActivity)" as View
participant "PatientController" as Controller
participant "MedicalRecordService" as Service
participant "MedicalRecordRepository" as Repo
database "PostgreSQL" as DB

Doctor -> View: Mở tab Lịch sử bệnh nhân
activate View
View -> Controller: getPatientHistory(patientId)
activate Controller
Controller -> Service: getMedicalHistory(patientId)
activate Service
Service -> Repo: findByPatientId(patientId)
Repo -> DB: SELECT * FROM medical_record...
DB --> Repo: records
Repo --> Service: records
Service --> Controller: List<MedicalRecord>
Controller --> View: 200 OK
View --> Doctor: Hiển thị các bệnh án cũ
deactivate View
@enduml