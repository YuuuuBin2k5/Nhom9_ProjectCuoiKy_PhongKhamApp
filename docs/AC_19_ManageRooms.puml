@startuml
title Activity Diagram: AC_19 Quản lý Phòng khám

|Quản trị viên|
start
:Vào trang Quản lý Phòng khám;
:Hệ thống hiển thị danh sách các phòng hiện có;

if (Chọn hành động?) then (Thêm mới / Chỉnh sửa)
    :Nhập/Cập nhật thông tin: Tên phòng, \nLoại phòng (Tổng quát, Phẫu thuật...), Chức năng;
    :Lưu thông tin vào hệ thống;
    :Thông báo cập nhật thành công;

elseif (Xóa phòng)
    :Chọn phòng muốn xóa khỏi hệ thống;
    if (Đã có Lịch hẹn hoặc Ca khám từng diễn ra?) then (Có dữ liệu liên quan)
        :Thông báo: "Không thể xóa phòng vì đã có dữ liệu lịch sử";
        :Gợi ý chuyển sang trạng thái "Ngưng hoạt động";
        if (Xác nhận ngưng hoạt động?) then (Đồng ý)
            goto deactivate_label
        else (Hủy)
            stop
        endif
    else (Không có dữ liệu)
        :Hiển thị xác nhận xóa vĩnh viễn;
        if (Xác nhận xóa?) then (Đồng ý)
            :Thông báo xóa thành công;
        else (Hủy)
            stop
        endif
    endif

else (Đóng / Ngưng hoạt động)
    label deactivate_label
    :Chọn phòng cần tạm dừng hoạt động;
    :Cập nhật trạng thái [Status = INACTIVE / CLOSED];
    note right
        Phòng sẽ không thể chọn khi đặt lịch mới
        nhưng lịch sử khám cũ vẫn được bảo toàn.
    end note
    :Thông báo: "Phòng đã chuyển sang trạng thái ngưng hoạt động";
endif

stop
@enduml