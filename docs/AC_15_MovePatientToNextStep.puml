@startuml AC_15_MovePatientToNextStep_v2
title Activity Diagram: AC_15 Chuyển sang bước điều trị tiếp theo

|Bác sĩ|
start
:Hoàn tất bước điều trị hiện tại;

:Đánh dấu bước hiện tại = COMPLETED;

if (Bệnh nhân có tiếp tục điều trị?) then (Không)
    :Đánh dấu phác đồ = ABORTED;
    stop
else (Có)
endif

if (Còn bước tiếp theo?) then (Có)
    :Xác định bước điều trị tiếp theo;

    if (Bước tiếp theo ở phòng khác?) then (Có)
        :Chuyển bệnh nhân sang phòng mới;
        :Thêm vào hàng đợi mới;
        :Xếp sau các bệnh nhân đang chờ;
    else (Không)
        :Giữ bệnh nhân tại phòng hiện tại;
        :Tiếp tục bước điều trị tiếp theo;
    endif

else (Không)
    :Đánh dấu phác đồ = FINISHED;
endif

stop
@enduml