@startuml UC_18_ManageDoctors
title UC_UC_25: Quản lý bác sĩ

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor Default
    BorderColor Navy
    ArrowColor Navy
}

actor "Quản trị viên" as A

rectangle "Quản lý Bác sĩ" {
    usecase "Xem danh sách Bác sĩ" as UC1
    usecase "Tạo tài khoản Bác sĩ" as UC2
    usecase "Khóa/Bật tài khoản Bác sĩ" as UC3
    usecase "Cập nhật CSDL Tài khoản" as UCS
    
    UC2 ..> UCS : <<include>>
    UC3 ..> UCS : <<include>>
}

A --> UC1
A --> UC2
A --> UC3

@enduml
