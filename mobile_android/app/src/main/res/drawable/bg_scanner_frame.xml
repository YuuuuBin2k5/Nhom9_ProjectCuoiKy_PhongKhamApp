<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background (Subtle Glass) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#0D000000" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Corner Brackets -->
    <!-- Top-Left -->
    <item android:bottom="220dp" android:right="220dp">
        <shape>
            <stroke android:width="3dp" android:color="#3B82F6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Top-Right -->
    <item android:bottom="220dp" android:left="220dp">
        <shape>
            <stroke android:width="3dp" android:color="#3B82F6" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Bottom-Left -->
    <item android:top="220dp" android:right="220dp">
        <shape>
            <stroke android:width="3dp" android:color="#3B82F6" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Bottom-Right -->
    <item android:top="220dp" android:left="220dp">
        <shape>
            <stroke android:width="3dp" android:color="#3B82F6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
