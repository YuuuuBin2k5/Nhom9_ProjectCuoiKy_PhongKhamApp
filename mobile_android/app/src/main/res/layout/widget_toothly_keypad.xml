<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout style="@style/KeypadRow">
            <TextView android:id="@+id/key1" style="@style/KeypadKey" android:text="1\n " />
            <TextView android:id="@+id/key2" style="@style/KeypadKeyDental" android:text="2\nCheck-up" />
            <TextView android:id="@+id/key3" style="@style/KeypadKey" android:text="3\nDEF" />
        </LinearLayout>
        <LinearLayout style="@style/KeypadRow">
            <TextView android:id="@+id/key4" style="@style/KeypadKey" android:text="4\nGHI" />
            <TextView android:id="@+id/key5" style="@style/KeypadKeyDental" android:text="5\nPrevention" />
            <TextView android:id="@+id/key6" style="@style/KeypadKey" android:text="6\nMNO" />
        </LinearLayout>
        <LinearLayout style="@style/KeypadRow">
            <TextView android:id="@+id/key7" style="@style/KeypadKey" android:text="7\nPQRS" />
            <TextView android:id="@+id/key8" style="@style/KeypadKeyDental" android:text="8\nPolish" />
            <TextView android:id="@+id/key9" style="@style/KeypadKey" android:text="9\nWXYZ" />
        </LinearLayout>
        <LinearLayout style="@style/KeypadRow">
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView android:id="@+id/key0" style="@style/KeypadKeyDental" android:text="0\nHealth" />
            <TextView
                android:id="@+id/keyBack"
                style="@style/KeypadKey"
                android:text="⌫\n " />
        </LinearLayout>
    </LinearLayout>
</merge>
