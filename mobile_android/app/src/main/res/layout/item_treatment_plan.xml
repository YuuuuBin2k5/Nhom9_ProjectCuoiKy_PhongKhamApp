<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPlanStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/toothly_teal_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Đang điều trị" />

            <TextView
                android:id="@+id/tvPlanDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/toothly_text_muted"
                android:textSize="12sp"
                tools:text="23/03/2025" />
        </LinearLayout>
        
        <TextView
            android:id="@+id/tvPlanProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/toothly_teal_dark"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Tiến độ: 1/3 bước"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvNextStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/toothly_text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Tiếp theo: Lấy vôi răng"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/toothly_pearl_dark" />

        <LinearLayout
            android:id="@+id/stepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
