<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Vertical Line -->
    <View
        android:id="@+id/vTimelineLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#E1E5EA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp" />

    <!-- Timeline Dot -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvTimelineDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="#005B9F"
        app:cardCornerRadius="7dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/vTimelineLine"
        app:layout_constraintEnd_toEndOf="@id/vTimelineLine" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardMaxElevation="6dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/vTimelineLine">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Row: Date & Status -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15/10/2023 • 09:30 AM"
                    android:textColor="#546E7A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOÀN THÀNH"
                    android:textColor="#2E7D32"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_pill_gray_premium"
                    android:backgroundTint="#E8F5E9"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Diagnosis Title -->
            <TextView
                android:id="@+id/tvDiagnosisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Viêm phế quản cấp tính"
                android:textColor="#0D1B2A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Doctor Card inside EMR item -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_gray_premium"
                android:backgroundTint="#F4F6F8"
                android:padding="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDocAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_doctor"
                    app:shapeAppearanceOverlay="@style/CircleAppearance" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvDoctorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BS. Nguyễn Văn An"
                        android:textColor="#0D1B2A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDocSpec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khoa Nội tổng quát"
                        android:textColor="#546E7A"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Prescription List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#005B9F"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ĐƠN THUỐC"
                    android:textColor="#005B9F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                
                <TextView
                    android:id="@+id/tvDrug1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amoxicillin 500mg"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:background="@drawable/bg_pill_gray_premium"
                    android:backgroundTint="#EEF0F2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"/>
                
                <TextView
                    android:id="@+id/tvDrug2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paracetamol 500mg"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:background="@drawable/bg_pill_gray_premium"
                    android:backgroundTint="#EEF0F2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"/>
                
                <TextView
                    android:id="@+id/tvDrugExtra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+2 khác"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:background="@drawable/bg_pill_gray_premium"
                    android:backgroundTint="#EEF0F2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />
            </LinearLayout>

            <!-- View X-ray if available -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivXrayThumbnail"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_medical_services"
                android:background="#212121"
                app:tint="#757575"
                app:shapeAppearanceOverlay="@style/CircleAppearance" 
                app:cornerFamily="rounded"
                app:cornerSize="12dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetails"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Chi tiết"
                    android:textColor="#005B9F"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    app:strokeColor="#005B9F"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:icon="@drawable/ic_search"
                    app:iconTint="#005B9F"
                    app:iconGravity="textStart"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrescription"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Xem đơn thuốc"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    app:icon="@android:drawable/ic_menu_agenda"
                    app:iconGravity="textStart"
                    app:backgroundTint="#005B9F"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
