<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Edit Button (Hidden by default, shown when in read-only mode) -->
    <Button
        android:id="@+id/btnEditMode"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Chỉnh sửa"
        android:textSize="13sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        android:drawableStart="@android:drawable/ic_menu_edit"
        android:drawablePadding="6dp"
        style="@style/Widget.Material3.Button.TonalButton" />

    <!-- Clinical Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi chú sơ đồ răng (Dynamic)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvToothNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có ghi chú nào. Nhấn vào răng trên sơ đồ để thêm ghi chú."
                android:textSize="13sp"
                android:textColor="#546E7A"
                android:background="#F5F7FA"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tóm tắt lý do khám"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:gravity="top|start"
                android:hint="VD: Đau nhức R37..."
                android:background="@drawable/bg_card_white_rounded"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chẩn đoán sơ bộ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDiagnosis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:gravity="top|start"
                android:hint="VD: Viêm tủy cấp R37..."
                android:background="@drawable/bg_card_white_rounded"
                android:padding="12dp"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Clinical Images Card (NEW) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hình ảnh lâm sàng"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadGeneralImage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Tải ảnh lên"
                android:textAllCaps="false"
                app:icon="@drawable/ic_camera"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                android:layout_marginBottom="12dp"/>

            <!-- Image Preview Section -->
            <LinearLayout
                android:id="@+id/layoutImagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="#F5F7FA"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvImageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ảnh"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGeneralImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
