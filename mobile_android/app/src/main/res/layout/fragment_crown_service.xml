<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bọc răng sứ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="16dp"/>

        <!-- Crown Type Selection -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loại răng sứ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/spinnerCrownType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_card_white_rounded"
                    android:padding="12dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Selected Teeth Display -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Răng đã chọn"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSelectedTeeth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa chọn răng nào. Nhấn vào răng trên sơ đồ để chọn."
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectTeeth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chọn răng trên sơ đồ"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_tooth"
                    app:iconGravity="textStart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Notes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etCrownNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:gravity="top|start"
                    android:hint="Nhập ghi chú về tình trạng răng, yêu cầu đặc biệt..."
                    android:background="@drawable/bg_card_white_rounded"
                    android:padding="12dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Edit Mode Button (hidden by default) -->
        <Button
            android:id="@+id/btnEditMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <!-- Add Service Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCrownService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm dịch vụ bọc răng sứ"
            android:textAllCaps="false"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            android:layout_marginTop="8dp"
            style="@style/Widget.Material3.Button"/>

    </LinearLayout>

</ScrollView>
