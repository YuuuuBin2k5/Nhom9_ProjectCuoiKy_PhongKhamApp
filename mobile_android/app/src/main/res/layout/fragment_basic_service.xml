<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvServiceNameHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chi tiết dịch vụ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="16dp"/>

        <!-- Selected Teeth Display -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vị trí răng thực hiện"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSelectedTeeth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa chọn răng nào. Nhấn vào răng trên sơ đồ để chọn."
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectTeeth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chọn răng trên sơ đồ"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_tooth"
                    app:iconGravity="textStart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Diagnosis / Chuẩn đoán -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chẩn đoán lâm sàng"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etBasicDiagnosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:gravity="top|start"
                    android:hint="Nhập chẩn đoán..."
                    android:background="@drawable/bg_card_white_rounded"
                    android:padding="12dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Notes / Ghi chú -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú quá trình điều trị"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etBasicNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:gravity="top|start"
                    android:hint="Mô tả quá trình thực hiện, tình trạng răng..."
                    android:background="@drawable/bg_card_white_rounded"
                    android:padding="12dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Images section / Tải hình ảnh -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hình ảnh quá trình điều trị"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="8dp"/>
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Để tải ảnh đính kèm, vui lòng sử dụng phần 'Ảnh Kết Quả' ở cuối màn hình."
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="8dp"
                    android:textStyle="italic" />

                <!-- Chúng ta vẫn có thể dùng RecyclerView ở cấp độ Fragment nếu sau này muốn tách hẳn Upload vào từng form, nhưng hiện tại DoctorWorkflowActivity đang quản lý Upload Image thông qua ImageLauncher -->

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



    </LinearLayout>

</ScrollView>
