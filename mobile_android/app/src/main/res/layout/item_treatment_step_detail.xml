<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#FAFAFA">

    <TextView
        android:id="@+id/tvStepNumber"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="1"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/circle_semi_transparent"
        android:gravity="center"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvServiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhổ răng"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0D1B2A" />

        <TextView
            android:id="@+id/tvStepNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú của bác sĩ"
            android:textSize="12sp"
            android:textColor="#546E7A"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvCompletedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15/03/2026 10:30"
            android:textSize="11sp"
            android:textColor="#90A4AE"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
