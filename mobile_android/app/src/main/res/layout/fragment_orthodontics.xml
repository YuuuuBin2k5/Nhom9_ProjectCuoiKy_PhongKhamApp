<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp">

    <TextView 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:text="Hồ sơ Hình ảnh Niềng răng" 
        android:textSize="16sp" 
        android:textColor="#0D1B2A"
        android:textStyle="bold" 
        android:layout_marginBottom="8dp"/>
        
    <TextView 
        android:id="@+id/tvStepInfo"
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:text="Tiến độ (Auto Load theo Treatment Plan)" 
        android:textColor="#546E7A"
        android:layout_marginBottom="16dp"/>
    
    <LinearLayout 
        android:orientation="horizontal" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnUploadBefore" 
            android:layout_width="0dp" 
            android:layout_weight="1" 
            android:layout_height="wrap_content" 
            android:text="Ảnh Mặt thẳng"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnUploadAfter" 
            android:layout_width="0dp" 
            android:layout_weight="1" 
            android:layout_height="wrap_content" 
            android:text="Ảnh Cận hàm" 
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    
    <ImageView 
        android:id="@+id/ivPreview" 
        android:layout_width="match_parent" 
        android:layout_height="220dp" 
        android:background="#FAFAFA" 
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="#BDBDBD"/>
        
    <EditText 
        android:id="@+id/etOrthoNotes" 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:hint="Ghi chú thay đổi lực kéo, loại dây cung, tình trạng nướu..." 
        android:minLines="4" 
        android:gravity="top" 
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_white_rounded"
        android:padding="12dp"/>
</LinearLayout>
