<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Timeline Line Element -->
    <View
        android:id="@+id/timelineLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#CBD5E1"
        app:layout_constraintTop_toBottomOf="@+id/timelineDot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/timelineDot"
        app:layout_constraintEnd_toEndOf="@+id/timelineDot"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="-8dp"/> <!-- Extend down to next item -->

    <!-- Timeline Dot -->
    <ImageView
        android:id="@+id/timelineDot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_check_circle"
        app:tint="#94A3B8" 
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toEndOf="@+id/timelineDot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/tvStepName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="1. Khám tổng quát &amp; Xquang" />

                <TextView
                    android:id="@+id/tvStepStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_grey"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    tools:text="Chờ" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStepRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Phòng khám"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvStepDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#0EA5E9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Bác sĩ: Nguyễn Văn A" />

            <TextView
                android:id="@+id/tvStepMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Răng 36 • Hoàn thành: 2026-03-31" />

            <TextView
                android:id="@+id/tvDoctorConclusion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC"
                android:padding="10dp"
                android:textColor="#334155"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Ghi chú: Răng hàm trái số 7 bị sâu, cần vệ sinh tủy."
                tools:visibility="visible" />

            <!-- Media Attachments Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStepImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
