<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <!-- Timeline Line Element -->
    <View
        android:id="@+id/timelineLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#E2E8F0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/nodeContainer"
        app:layout_constraintStart_toStartOf="@+id/nodeContainer"
        app:layout_constraintTop_toBottomOf="@+id/nodeContainer" />

    <!-- Numbered Node -->
    <FrameLayout
        android:id="@+id/nodeContainer"
        android:layout_width="48dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardStep">

        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_generic"
            android:backgroundTint="#CBD5E1"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="1" />
    </FrameLayout>

    <!-- Step Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStep"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/nodeContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Header: Icon + Title + Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStepIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_generic"
                    android:backgroundTint="#F1F5F9"
                    android:padding="8dp"
                    android:src="@drawable/ic_treatment_plan"
                    app:tint="#3B82F6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStepName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="1. Khám và tư vấn" />

                    <TextView
                        android:id="@+id/tvStepStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_pill_generic"
                        android:backgroundTint="#FEF3C7"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="#D97706"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="Chờ" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivStepStatusIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="#D97706" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#F1F5F9" />

            <!-- Card Body: Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llDoctorInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BS. phụ trách: "
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvStepDoctor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="BS. Trọng Trần Đình" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDurationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian dự kiến: "
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvStepDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        tools:text="30-45 phút" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llNoteInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ghi chú: "
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvDoctorConclusion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_pill_generic"
                        android:backgroundTint="#F8FAFC"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        tools:text="Thăm khám tổng quát, chụp X-quang tư vấn phác đồ điều trị răng hàm." />
                </LinearLayout>

                <!-- Shortcut Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStepAction"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#EBF5FF"
                    android:text="Đặt lịch"
                    android:textColor="#3B82F6"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_calendar"
                    app:iconTint="#3B82F6"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/llPrescriptionInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đơn thuốc: "
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:id="@+id/llPrescriptionItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_pill_generic"
                        android:backgroundTint="#F0F9FF"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp" />
                </LinearLayout>

                <!-- Media Attachments Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStepImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
