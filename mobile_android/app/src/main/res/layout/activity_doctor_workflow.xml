<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFB">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#1565C0"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Quay lại"
            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_patient_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khám Bệnh nhân..."
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_doctor_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sơ đồ răng &amp; Phác đồ"
                android:textColor="#E3F2FD"
                android:textSize="13sp" />
        </LinearLayout>
        
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_calendar"
            app:tint="@android:color/white"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Patient Lookup (Visible initially, hidden after lookup) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLookup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tra cứu bệnh nhân"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0D1B2A"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etQrInput"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:hint="Mã BN (VD: patient:1)..."
                            android:background="@drawable/bg_card_white_rounded"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />

                        <ImageButton
                            android:id="@+id/btnScanQr"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_card_white_rounded"
                            android:src="@drawable/ic_qr_scan"
                            android:layout_marginEnd="8dp"
                            android:padding="10dp"
                            app:tint="#1565C0"
                            android:contentDescription="Quét QR" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLookup"
                            android:layout_width="wrap_content"
                            android:layout_height="45dp"
                            android:text="Tìm kiếm"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            app:cornerRadius="8dp"
                            app:backgroundTint="#1565C0"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Main Examination Area (Hidden until patient found) -->
            <LinearLayout
                android:id="@+id/layoutExamination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xem Lịch sử Khám bệnh"
                    android:layout_marginBottom="12dp"
                    app:iconGravity="textStart"
                    app:icon="@android:drawable/ic_menu_info_details"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleFormType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@+id/btnFormGeneral">
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFormGeneral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tổng quát"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFormSurgery"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tiểu phẫu"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFormOrtho"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Niềng răng"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragmentContainerForm"
                    android:name="com.hcmute.mobile_android.ui.fragments.FragmentGeneralDental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <!-- Treatment Plan Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTreatmentPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Phác đồ điều trị đề xuất"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0D1B2A" />
                                
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectTemplate"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Mẫu phác đồ"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                app:cornerRadius="16dp"
                                app:backgroundTint="#E3F2FD"
                                android:textColor="#1565C0"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>

                        <!-- Horizontal list of templates (Visible when button clicked, or keep hidden here and use a dialog) -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTemplates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTreatmentSteps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <!-- Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:weightSum="3">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSavePlan"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Lưu Hồ Sơ"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                app:cornerRadius="8dp"
                                app:backgroundTint="#1565C0"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTransferXRay"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Chuyển X-Quang"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:textColor="#E65100"
                                app:cornerRadius="8dp"
                                app:backgroundTint="#FFF3E0"
                                app:strokeColor="#FFB74D"
                                app:strokeWidth="1dp"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPrescribe"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Kê Đơn"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:textColor="#1565C0"
                                app:cornerRadius="8dp"
                                app:backgroundTint="@android:color/white"
                                app:strokeColor="#1565C0"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrintPlan"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="In Phác đồ"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textColor="#546E7A"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>