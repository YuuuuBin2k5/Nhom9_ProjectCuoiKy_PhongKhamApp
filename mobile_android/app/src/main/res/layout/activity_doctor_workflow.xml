<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFB">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#1565C0"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Quay lại"
            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_patient_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khám Bệnh nhân..."
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_doctor_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sơ đồ răng &amp; Phác đồ"
                android:textColor="#E3F2FD"
                android:textSize="13sp" />
        </LinearLayout>
        
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_calendar"
            app:tint="@android:color/white"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Patient Lookup (Visible initially, hidden after lookup) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLookup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tra cứu bệnh nhân"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0D1B2A"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etQrInput"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:hint="Mã BN (VD: patient:1)..."
                            android:background="@drawable/bg_card_white_rounded"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />

                        <ImageButton
                            android:id="@+id/btnScanQr"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_card_white_rounded"
                            android:src="@drawable/ic_qr_scan"
                            android:layout_marginEnd="8dp"
                            android:padding="10dp"
                            app:tint="#1565C0"
                            android:contentDescription="Quét QR" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLookup"
                            android:layout_width="wrap_content"
                            android:layout_height="45dp"
                            android:text="Tìm kiếm"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            app:cornerRadius="8dp"
                            app:backgroundTint="#1565C0"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Main Examination Area (Hidden until patient found) -->
            <LinearLayout
                android:id="@+id/layoutExamination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xem Lịch sử Khám bệnh"
                    android:layout_marginBottom="12dp"
                    app:iconGravity="textStart"
                    app:icon="@android:drawable/ic_menu_info_details"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleFormType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@+id/btnFormGeneral">
                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFormGeneral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tổng quát"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFormSurgery"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tiểu phẫu"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFormOrtho"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Niềng răng"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFormXray"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="X-Quang"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragmentContainerForm"
                    android:name="com.hcmute.mobile_android.ui.fragments.FragmentGeneralDental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <!-- Odontogram View (Tooth Selection) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Biểu Đồ Răng - Chọn Dịch Vụ Cụ Thể"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0D1B2A"
                            android:layout_marginBottom="12dp" />

                        <com.hcmute.mobile_android.ui.views.OdontogramView
                            android:id="@+id/odontogramView"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:background="@android:color/white" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nhấp vào một răng để thêm dịch vụ cụ thể"
                            android:textSize="12sp"
                            android:textColor="#78909C"
                            android:layout_marginTop="8dp"
                            android:gravity="center" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Treatment Plan Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTreatmentPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Phác đồ điều trị đề xuất"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0D1B2A" />
                                
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddService"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="+ Thêm dịch vụ"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                app:cornerRadius="16dp"
                                app:backgroundTint="#E8F5E9"
                                android:textColor="#2E7D32"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectTemplate"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Mẫu phác đồ"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                app:cornerRadius="16dp"
                                app:backgroundTint="#E3F2FD"
                                android:textColor="#1565C0"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>

                        <!-- Horizontal list of templates (Visible when button clicked, or keep hidden here and use a dialog) -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTemplates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTreatmentSteps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPriceBreakdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layout_result_images"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ảnh Kết Quả / X-Quang"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0D1B2A"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rvResultImages"
                                    android:layout_width="0dp"
                                    android:layout_height="80dp"
                                    android:layout_weight="1"
                                    android:orientation="horizontal" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnUploadImage"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    android:layout_marginStart="8dp"
                                    app:icon="@drawable/ic_camera"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    app:strokeColor="#1565C0"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutDoctorConclusion"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp"
                            android:hint="Kết luận &amp; Ghi chú của bác sĩ">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDoctorConclusion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:inputType="textMultiLine"
                                android:minLines="3" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tổng tạm tính:"
                                android:textSize="14sp"
                                android:textColor="#546E7A" />

                            <TextView
                                android:id="@+id/tvTotalEstimate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 VNĐ"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#1565C0" />
                        </LinearLayout>

                        <!-- Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:weightSum="3">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnActivatePlan"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Kích Hoạt\nPhác đồ"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                app:cornerRadius="8dp"
                                app:backgroundTint="#2E7D32"
                                android:layout_marginEnd="4dp"
                                android:visibility="gone" />

                            <!-- REMOVED: Draft save button - plans are now auto-activated -->
                            <!--
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSavePlan"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Lưu Hồ Sơ\n(Nháp)"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                app:cornerRadius="8dp"
                                app:backgroundTint="#1565C0"
                                android:layout_marginEnd="4dp" />
                            -->

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCompleteStep"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Hoàn thành\nBước khám"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                app:cornerRadius="8dp"
                                app:backgroundTint="#FF6D00"
                                android:layout_marginEnd="4dp"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPrescribe"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Kê Đơn"
                                android:textSize="12sp"
                                android:textAllCaps="false"
                                android:textColor="#1565C0"
                                app:cornerRadius="8dp"
                                app:backgroundTint="@android:color/white"
                                app:strokeColor="#1565C0"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelStep"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Hủy Bước"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:textColor="#D32F2F"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@android:color/white"
                            app:strokeColor="#D32F2F"
                            app:strokeWidth="1dp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCompleteTreatment"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:text="Hoàn thành Điều trị &amp; Ký Hóa đơn"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            app:cornerRadius="8dp"
                            app:backgroundTint="#FF9800"
                            android:layout_marginTop="16dp"
                            android:enabled="false"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrintPlan"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="In Phác đồ"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textColor="#546E7A"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>