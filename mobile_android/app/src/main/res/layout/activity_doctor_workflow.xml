<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFB">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#1565C0"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Quay lại"
            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tv_patient_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khám Bệnh nhân..."
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_doctor_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sơ đồ răng &amp; Phác đồ"
                android:textColor="#E3F2FD"
                android:textSize="13sp" />
        </LinearLayout>
        
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_calendar"
            app:tint="@android:color/white"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Patient Lookup (Visible initially, hidden after lookup) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLookup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tra cứu bệnh nhân"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0D1B2A"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etQrInput"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:hint="Mã BN (VD: patient:1)..."
                            android:background="@drawable/bg_card_white_rounded"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />

                        <ImageButton
                            android:id="@+id/btnScanQr"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@drawable/bg_card_white_rounded"
                            android:src="@drawable/ic_qr_scan"
                            android:layout_marginEnd="8dp"
                            android:padding="10dp"
                            app:tint="#1565C0"
                            android:contentDescription="Quét QR" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLookup"
                            android:layout_width="wrap_content"
                            android:layout_height="45dp"
                            android:text="Tìm kiếm"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            app:cornerRadius="8dp"
                            app:backgroundTint="#1565C0"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Main Examination Area (Hidden until patient found) -->
            <LinearLayout
                android:id="@+id/layoutExamination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Odontogram Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sơ đồ răng (FDI)"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0D1B2A"
                            android:layout_marginBottom="8dp" />

                        <com.hcmute.mobile_android.ui.views.OdontogramView
                            android:id="@+id/odontogramView"
                            android:layout_width="match_parent"
                            android:layout_height="320dp"
                            android:background="#FAFAFA" />
                            
                        <!-- Legend -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:scrollbars="none">
                            
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                
                                <!-- Sâu răng -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_status_waiting"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp">
                                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/circle_red_dot" android:layout_marginEnd="4dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sâu răng" android:textSize="11sp" android:textColor="#D32F2F"/>
                                </LinearLayout>
                                
                                <!-- Đã trám -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_hcmut_badge"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp">
                                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/circle_blue_dot" android:layout_marginEnd="4dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã trám" android:textSize="11sp" android:textColor="#1565C0"/>
                                </LinearLayout>
                                
                                <!-- BN yêu cầu -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_status_in_progress"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp">
                                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="#4CAF50" android:layout_marginEnd="4dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BN yêu cầu" android:textSize="11sp" android:textColor="#2E7D32"/>
                                </LinearLayout>
                                
                                <!-- Cần chữa tủy -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:background="#FFF3E0"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp">
                                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/circle_orange_dot" android:layout_marginEnd="4dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cần chữa tủy" android:textSize="11sp" android:textColor="#E65100"/>
                                </LinearLayout>

                            </LinearLayout>
                        </HorizontalScrollView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Clinical Details Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ghi chú sơ đồ răng (Dynamic)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0D1B2A"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvToothNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chưa có ghi chú nào. Nhấn vào răng trên sơ đồ để thêm ghi chú."
                            android:textSize="13sp"
                            android:textColor="#546E7A"
                            android:background="#F5F7FA"
                            android:padding="10dp"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tóm tắt lý do khám"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0D1B2A"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="2"
                            android:gravity="top|start"
                            android:hint="VD: Đau nhức R37, nhạy cảm nóng lạnh..."
                            android:background="@drawable/bg_card_white_rounded"
                            android:padding="12dp"
                            android:textSize="14sp"
                            android:layout_marginBottom="16dp" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chẩn đoán sơ bộ"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0D1B2A"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etDiagnosis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="2"
                            android:gravity="top|start"
                            android:hint="VD: Viêm tủy cấp R37, mảng bám nhiều..."
                            android:background="@drawable/bg_card_white_rounded"
                            android:padding="12dp"
                            android:textSize="14sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Treatment Plan Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTreatmentPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Phác đồ điều trị đề xuất"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0D1B2A" />
                                
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectTemplate"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Mẫu phác đồ"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                app:cornerRadius="16dp"
                                app:backgroundTint="#E3F2FD"
                                android:textColor="#1565C0"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>

                        <!-- Horizontal list of templates (Visible when button clicked, or keep hidden here and use a dialog) -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTemplates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTreatmentSteps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <!-- Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:weightSum="2">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSavePlan"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Lưu Hồ Sơ"
                                android:textSize="14sp"
                                android:textAllCaps="false"
                                app:cornerRadius="8dp"
                                app:backgroundTint="#1565C0"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPrescribe"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="Kê Đơn Thuốc"
                                android:textSize="14sp"
                                android:textAllCaps="false"
                                android:textColor="#1565C0"
                                app:cornerRadius="8dp"
                                app:backgroundTint="@android:color/white"
                                app:strokeColor="#1565C0"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrintPlan"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="In Phác đồ"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textColor="#546E7A"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>