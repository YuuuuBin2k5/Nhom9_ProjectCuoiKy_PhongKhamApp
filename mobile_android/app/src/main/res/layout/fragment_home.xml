<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Main scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- HEADER SECTION with subtle gradient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_gradient_premium"
                android:paddingTop="52dp"
                android:paddingBottom="28dp"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Avatar with ring -->
                    <FrameLayout
                        android:layout_width="54dp"
                        android:layout_height="54dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_user"
                            android:padding="10dp"
                            android:background="@drawable/bg_avatar_ring"
                            app:tint="#3B82F6"/>
                        <ImageView
                            android:id="@+id/iv_profile_warning"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="#F59E0B"
                            android:layout_gravity="top|end"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <!-- Greeting text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tv_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hi, Patient 👋"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:textSize="19sp"
                            android:letterSpacing="-0.01"/>

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="How is your smile today?"
                            android:textSize="13sp"
                            android:textColor="#64748B"/>
                    </LinearLayout>

                    <!-- Action icons -->
                    <ImageView
                        android:id="@+id/ivHeaderLogout"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_logout"
                        app:tint="#3B82F6"
                        android:background="@drawable/bg_icon_circle_white"
                        android:padding="10dp"
                        android:layout_marginEnd="10dp"/>

                    <ImageView
                        android:id="@+id/iv_notification"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_notification"
                        app:tint="#3B82F6"
                        android:background="@drawable/bg_icon_circle_white"
                        android:padding="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- HERO BANNER -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#3B82F6">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_banner_hero_premium"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Nụ cười hoàn hảo\nbắt đầu từ đây"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="4dp"
                        android:letterSpacing="-0.01"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivBannerDecor"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_qr_scan"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="18dp"
                        android:text="📱 Quét mã QR / Đặt chỗ"
                        android:textAllCaps="false"
                        android:textColor="#3B82F6"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="22dp"
                        app:icon="@null"
                        app:layout_constraintTop_toBottomOf="@id/tvBannerTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <ImageView
                        android:id="@+id/ivBannerDecor"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_treatment_plan"
                        app:tint="#40FFFFFF"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:alpha="0.8"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CATEGORIES SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Danh mục"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:letterSpacing="-0.01"/>

                <TextView
                    android:id="@+id/all_dv_cat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem tất cả"
                    android:textSize="13sp"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="28dp"/>

            <!-- SERVICES SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Our Services"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:letterSpacing="-0.01"/>

                <TextView
                    android:id="@+id/all_dv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textSize="13sp"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="28dp"/>

            <!-- UPCOMING APPOINTMENTS SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upcoming Appointments"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:letterSpacing="-0.01"/>

                <TextView
                    android:id="@+id/all_appointment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textSize="13sp"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>

            <!-- Appointment Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_appointment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:id="@+id/layout_no_appointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="36dp"
                    android:paddingBottom="36dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅"
                        android:textSize="32sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Bạn chưa có lịch hẹn nào."
                        android:textColor="#94A3B8"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_appointment_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle_blue_soft">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_calendar"
                                android:layout_gravity="center"
                                app:tint="#3B82F6"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_marginStart="16dp"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_appointment_doctor_name"
                                android:text="BS. Nguyễn Văn An"
                                android:textStyle="bold"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"/>

                            <TextView
                                android:id="@+id/tv_appointment_service_name"
                                android:text="Khám tổng quát"
                                android:textColor="#64748B"
                                android:textSize="13sp"
                                android:layout_marginTop="3dp"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"/>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_appointment_detail"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:icon="@drawable/ic_add_white"
                            app:iconTint="#3B82F6"
                            app:backgroundTint="#EFF6FF"
                            app:cornerRadius="14dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tv_appointment_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:15 AM • Hôm nay"
                        android:textColor="#3B82F6"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- DOCTORS SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bác sĩ gợi ý"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:letterSpacing="-0.01"/>

                <TextView
                    android:id="@+id/all_bs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textSize="13sp"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_doctors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- EMERGENCY FAB — floating pill button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabEmergency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="24dp"
        android:layout_marginBottom="88dp"
        android:text="Cấp cứu"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#EF4444"
        app:icon="@drawable/ic_emergency"
        app:iconTint="#FFFFFF"
        app:elevation="12dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
