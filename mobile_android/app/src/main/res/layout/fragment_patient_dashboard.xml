<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout 
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp">

                <!-- 1. Header: Modern Profile and Notification -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">
                    
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_user"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleAppearance" 
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"/>

                    <ImageView
                        android:id="@+id/ivWarningProfile"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignTop="@id/ivAvatar"
                        android:layout_alignEnd="@id/ivAvatar"
                        android:src="@drawable/ic_error_circle"
                        android:visibility="gone"
                        app:tint="#EF4444" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivAvatar"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How is your smile today? ✨"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/tvPatientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Floyd Miles"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_notifications"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_bell"
                        android:background="@drawable/bg_circle_icon"
                        app:tint="@color/text_primary"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <!-- 2. Search & Filter Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_pill_search"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:layout_toStartOf="@+id/ivHeaderQrScan"
                            android:layout_marginEnd="12dp">
                            
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_search"
                                app:tint="@color/text_secondary"/>
                                
                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="Search your oral..."
                                android:textSize="15sp"
                                android:layout_marginStart="12dp"
                                android:textColorHint="#94A3B8"/>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivHeaderQrScan"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_qr_scan"
                            android:background="@drawable/bg_circle_premium"
                            app:tint="@color/white"
                            android:padding="14dp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </LinearLayout>

                <!-- 3. Special Offer Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginBottom="32dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_premium_gradient_blue"
                        android:padding="24dp">
                        
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_centerVertical="true">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SPECIAL OFFER"
                                android:textColor="#E0F2FE"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"/>
                                
                            <TextView
                                android:layout_width="150dp"
                                android:layout_height="wrap_content"
                                android:text="Get 40% Off on Dental Scaling!"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="6dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBannerAction"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="16dp"
                                android:text="Call Now"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:cornerRadius="20dp"
                                app:backgroundTint="@color/white"
                                android:textColor="@color/primary_trust_blue"
                                app:icon="@android:drawable/ic_menu_call"
                                app:iconSize="14dp"
                                app:iconTint="@color/primary_trust_blue"
                                android:paddingHorizontal="20dp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="160dp"
                            android:layout_height="200dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:src="@drawable/ic_3d_offer_tooth"
                            android:scaleType="centerInside"
                            android:translationY="20dp"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Active Check In Tracker -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckInStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="1dp"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:id="@+id/tvCheckInStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã Check-in" android:textStyle="bold" android:textColor="@color/primary_trust_blue" />
                        <TextView android:id="@+id/tvQueuePosition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vị trí: 1" android:layout_marginTop="4dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnViewQueue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem hàng đợi" android:layout_marginTop="12dp" app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Unified Dental Services Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dental Services" 
                        android:textSize="20sp" 
                        android:textStyle="bold" 
                        android:textColor="@color/text_primary"/>
                    
                    <TextView
                        android:id="@+id/all_dv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See All"
                        android:textColor="@color/primary_trust_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="4dp"/>
                </RelativeLayout>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs_categories"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    app:tabMode="scrollable"
                    app:tabIndicatorHeight="0dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabBackground="@drawable/bg_tab_selector"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextColor="@color/text_secondary"
                    android:background="@android:color/transparent"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_services"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:clipToPadding="false"/>

                <!-- 6. Upcoming Appointments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Appointments" 
                    android:textSize="18sp" 
                    android:textStyle="bold" 
                    android:textColor="@color/text_primary" 
                    android:layout_marginBottom="16dp"/>
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcomingAppointments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:clipToPadding="false"/>

                <!-- 7. Premium Available Doctors -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Doctors" 
                        android:textSize="20sp" 
                        android:textStyle="bold" 
                        android:textColor="@color/text_primary"/>
                    
                    <ImageView
                        android:id="@+id/all_bs"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:src="@android:drawable/ic_menu_send"
                        android:rotation="180"
                        app:tint="@color/text_primary"/>
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_doctors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="110dp"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
