<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background_soft">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout 
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="24dp">

                <!-- 1. Header: Modern Profile and Notification -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">
                    
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_user"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleAppearance" 
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"/>

                    <ImageView
                        android:id="@+id/ivWarningProfile"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignTop="@id/ivAvatar"
                        android:layout_alignEnd="@id/ivAvatar"
                        android:src="@drawable/ic_error_circle"
                        android:visibility="gone"
                        app:tint="#EF4444" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivAvatar"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How is your smile today? ✨"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/tvPatientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguyễn Văn A"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_notifications"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:src="@drawable/ic_bell"
                        android:background="@drawable/bg_circle_icon"
                        app:tint="@color/text_primary"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>

                <!-- 2. Search & Filter Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_toStartOf="@+id/ivHeaderQrScan"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="3dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/white">
                            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp">
                                
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@android:drawable/ic_menu_search"
                                    app:tint="@color/text_secondary"/>
                                    
                                <EditText
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:hint="Tìm kiếm dịch vụ hoặc bác sĩ"
                                    android:textSize="14sp"
                                    android:layout_marginStart="12dp"
                                    android:textColorHint="#94A3B8"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <ImageView
                            android:id="@+id/ivHeaderQrScan"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_qr_scan"
                            android:background="@drawable/bg_circle_premium"
                            app:tint="@color/white"
                            android:padding="14dp"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </LinearLayout>

                <!-- 3. Special Offer Banner Redesigned -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="158dp"
                    android:layout_marginBottom="28dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_premium_gradient_blue">

                        <!-- Subtle overlay orbs -->
                        <View
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:background="@drawable/circle_blue_dot"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_marginTop="-50dp"
                            android:layout_marginEnd="-20dp"
                            android:alpha="0.2"/>
                        <View
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:background="@drawable/circle_blue_dot"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="-80dp"
                            android:layout_marginBottom="-80dp"
                            android:alpha="0.1"/>

                        <!-- Tooth mascot — clipped neatly by card cornerRadius -->
                        <ImageView
                            android:layout_width="155dp"
                            android:layout_height="158dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:src="@drawable/ic_3d_tooth_megaphone_offer_v2"
                            android:scaleType="centerInside"/>

                        <!-- Text + Button -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_centerVertical="true"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ƯU ĐÃI ĐẶC BIỆT"
                                android:textColor="#FFD54F"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="bottom"
                                android:layout_marginTop="2dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="GIẢM "
                                    android:textColor="@color/white"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="3dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="40%"
                                    android:textColor="#FFB300"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dịch vụ Lấy cao răng"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:alpha="0.9"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBannerAction"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginTop="10dp"
                                android:text="Đặt lịch ưu đãi"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:cornerRadius="20dp"
                                app:backgroundTint="@color/white"
                                android:textColor="@color/primary_trust_blue"
                                app:icon="@drawable/ic_calendar"
                                app:iconSize="16dp"
                                app:iconTint="@color/primary_trust_blue"
                                android:paddingHorizontal="20dp"/>
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCheckInStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#EAF4FF"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:id="@+id/tvCheckInStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đã Check-in" android:textStyle="bold" android:textColor="@color/primary_trust_blue" />
                        <TextView android:id="@+id/tvQueuePosition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vị trí: 1" android:layout_marginTop="4dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnViewQueue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem hàng đợi" android:layout_marginTop="12dp" app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>




                <!-- 4. Unified Dental Services Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dịch vụ nổi bật"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/navy_blue_text"/>
                    
                    <TextView
                        android:id="@+id/all_dv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem thêm"
                        android:textColor="@color/primary_trust_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="4dp"/>
                </RelativeLayout>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs_categories"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    app:tabMode="scrollable"
                    app:tabIndicatorHeight="0dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabBackground="@drawable/bg_tab_selector"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextColor="@color/text_secondary"
                    android:background="@android:color/transparent"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_services"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:clipToPadding="false"/>

                <!-- 6. Upcoming Appointments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch hẹn sắp tới"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="14dp"/>
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcomingAppointments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:clipToPadding="false"/>

                <!-- 7. Premium Available Doctors -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đội ngũ bác sĩ"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/navy_blue_text"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"/>
                        
                    <TextView
                        android:id="@+id/btnViewAllDoctors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem thêm"
                        android:textColor="@color/primary_trust_blue"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_doctors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="110dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
