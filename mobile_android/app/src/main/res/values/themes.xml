<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Toothly" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@color/toothly_pearl</item>
        <item name="android:navigationBarColor">@color/toothly_pearl</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Tránh phủ màu primary (teal) lên surface/card khi có elevation → hết card “xanh mint” -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorPrimary">@color/primary_trust_blue</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
    </style>

    <style name="Theme.Mobile_android" parent="Base.Theme.Toothly" />

    <style name="ToothlyHeading">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/toothly_teal_dark</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="ToothlyBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/toothly_text_body</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ToothlyLink">
        <item name="android:textColor">@color/toothly_link</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CircleAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedAppearance16">
        <item name="cornerSize">16dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <!-- Premium Bottom Navigation Style -->
    <style name="Widget.App.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_selector_color</item>
        <item name="itemTextColor">@color/nav_selector_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigation.ActiveIndicator</item>
        <item name="itemRippleColor">@color/primary_trust_blue_light_trans</item>
    </style>

    <style name="Widget.App.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_trust_blue_light_trans</item>
    </style>
</resources>