<?xml version='1.0' encoding='utf-8'?>
<resources>
    
    <style name="Theme.PhongKham_App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
<style name="Theme.HopitalApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/primaryBlue</item>
        <item name="colorPrimaryVariant">@color/primaryDarkBlue</item>
        <item name="colorOnPrimary">@color/textOnPrimary</item>
        <item name="colorSecondary">@color/accentBlue</item>
        <item name="colorSecondaryVariant">@color/primaryDarkBlue</item> 
        <item name="colorOnSecondary">@color/black</item>

        
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@color/windowBackground</item>

        
        
    </style>

    

    <style name="RoundedFull">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
<style name="Base.Theme.BaiTap03" parent="Theme.Material3.DayNight.NoActionBar">
        
        
    </style>

    <style name="Theme.BaiTap03" parent="Base.Theme.BaiTap03" />
<style name="Base.Theme.Doan_mobileapp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/primary_light</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Doan_mobileapp" parent="Base.Theme.Doan_mobileapp" />

    
    <style name="TextAppearance.MedicalApp.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MedicalApp.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MedicalApp.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.MedicalApp.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.MedicalApp.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="TextAppearance.MedicalApp.DoctorName" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    
    <style name="Widget.MedicalApp.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_rounded_button</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xxl</item>
        <item name="android:paddingEnd">@dimen/spacing_xxl</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MedicalApp.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xxl</item>
        <item name="android:paddingEnd">@dimen/spacing_xxl</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MedicalApp.Button.PrimaryLarge" parent="Widget.MedicalApp.Button.Primary">
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    
    <style name="Widget.MedicalApp.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    
    <style name="Widget.MedicalApp.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/text_hint</item>
    </style>

    <style name="Widget.MedicalApp.TextInputLayout.Outline" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
    </style>

    
    <style name="Widget.MedicalApp.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/white</item>
        <item name="titleCentered">true</item>
        <item name="titleTextAppearance">@style/TextAppearance.MedicalApp.Title</item>
    </style>

    
    <style name="ShapeAppearance.MedicalApp.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

<style name="Theme.MyApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#3F7FB3</item>
        <item name="colorPrimaryContainer">#8DB6D8</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

</resources>