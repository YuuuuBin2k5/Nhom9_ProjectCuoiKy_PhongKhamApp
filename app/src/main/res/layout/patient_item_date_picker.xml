<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="56dp"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_sm">

    <!-- Day Label (e.g. "Th 2") -->
    <TextView
        android:id="@+id/tvDayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Th 2" />

    <!-- Date Circle Container -->
    <FrameLayout
        android:id="@+id/frameDate"
        android:layout_width="@dimen/date_circle_size"
        android:layout_height="@dimen/date_circle_size"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDayLabel">

        <!-- Selected Circle Background (GONE by default) -->
        <View
            android:id="@+id/viewCircleBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_date_selected"
            android:visibility="gone" />

        <!-- Date Number -->
        <TextView
            android:id="@+id/tvDateNumber"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            tools:text="15" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
