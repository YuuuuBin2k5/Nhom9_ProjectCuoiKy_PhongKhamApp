<?xml version="1.0" encoding="utf-8"?>
<!--
  File: activity_update_record.xml
  Mô tả: Layout cho màn hình cập nhật hồ sơ bệnh án và kê đơn thuốc.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context="com.example.phongkham_app.doctor.UpdateRecordActivity">

    <!-- Thanh App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Cập nhật bệnh án"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Khối nội dung chính có thể cuộn -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Form nhập liệu Triệu chứng -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Triệu chứng">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Form nhập liệu Chẩn đoán bệnh -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Chẩn đoán bệnh">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDiagnosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:lines="4" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Form nhập liệu Lời dặn -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Lời dặn của bác sĩ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phần Kê đơn và Kết quả xét nghiệm -->
            <TextView
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Kê đơn &amp; Kết quả xét nghiệm" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thêm hình ảnh kết quả xét nghiệm"
                app:icon="@drawable/ic_menu_camera" />

            <!-- *** SỬA LỖI CUỐI CÙNG: Dùng icon @drawable/ic_add *** -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMedicine"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thêm thuốc vào đơn"
                app:icon="@drawable/ic_add" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Nút CTA (Call To Action) dính dưới đáy -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinishAndUpdate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:text="Hoàn thành &amp; Gửi thông báo"
        android:textSize="16sp"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>