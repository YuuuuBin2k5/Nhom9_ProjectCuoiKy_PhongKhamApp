<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ================= CONTENT ================= -->
    <ScrollView
        android:id="@+id/home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_user"
                    android:padding="8dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:text="Xin chào,"
                        android:textSize="12sp"
                        android:layout_height="16dp"
                        android:layout_width="60dp"/>

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:text="Nguyễn A"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"/>

                <ImageView
                    android:id="@+id/ivHeaderLogout"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_logout"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>


            <!-- Button Dat Lich -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book_appointment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Đặt lịch khám"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:layout_marginTop="16dp"
                app:backgroundTint="@color/primary_blue"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_qr_scan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Quét QR Check-in"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/premium_emerald"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_qr_code"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Mã QR Check-in Của Tôi"
                android:textSize="18sp"
                android:textColor="@color/primary_blue"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/status_active_bg"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/primary_blue"/>


            <!-- Cuoc hen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:text="Cuộc hẹn hôm nay"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/all_appointment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"/>
            </LinearLayout>


            <!-- Card Cuoc Hen -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_appointment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:padding="10dp">

                <!-- No Appointments State -->
                <LinearLayout
                    android:id="@+id/layout_no_appointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Không có cuộc hẹn nào"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Detailed Appointment State -->
                <LinearLayout
                    android:id="@+id/layout_appointment_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="10dp">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_user"
                            android:padding="10dp"/>

                        <LinearLayout
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_appointment_doctor_name"
                                android:text="Đang tải..."
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:layout_height="26dp"
                                android:layout_width="300dp"/>

                            <TextView
                                android:id="@+id/tv_appointment_service_name"
                                android:text="Đang tải..."
                                android:layout_marginTop="5dp"
                                android:layout_height="20dp"
                                android:layout_width="wrap_content"/>
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="10dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_calendar"
                            android:layout_marginStart="10dp"/>

                        <TextView
                            android:id="@+id/tv_appointment_time"
                            android:text="Đang tải..."
                            android:textSize="18sp"
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"/>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_appointment_detail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Xem chi tiết"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/primary_blue"
                        app:backgroundTint="@color/status_active_bg"
                        app:cornerRadius="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- Dich Vu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:text="Dịch vụ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/all_dv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"/>
            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:layout_marginTop="10dp"/>


            <!-- Bac Si -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:text="Bác sĩ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/all_bs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"/>
            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_doctors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>

    </ScrollView>


    <!-- ================= BOTTOM NAV ================= -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/home_menu_bottom"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_color"
        app:itemTextColor="@color/nav_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>


