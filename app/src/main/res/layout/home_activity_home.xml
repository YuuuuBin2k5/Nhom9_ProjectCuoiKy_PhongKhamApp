<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2F8">

    <!-- ================= CONTENT ================= -->
    <ScrollView
        android:id="@+id/home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_user"
                    android:padding="8dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:text="Xin chào,"
                        android:textSize="12sp"
                        android:layout_height="16dp"
                        android:layout_width="60dp"/>

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:text="Nguyễn A"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"/>

                <ImageView
                    android:id="@+id/ivHeaderLogout"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_logout"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>


            <!-- Button Dat Lich -->
            <Button
                android:id="@+id/btn_book_appointment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Đặt lịch khám"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp"
                android:backgroundTint="#3A7CA5"
                android:background="@drawable/rounded_button"/>


            <!-- Cuoc hen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:text="Cuộc hẹn hôm nay"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/all_appointment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:background="@android:color/transparent"
                    android:textColor="#000000"/>
            </LinearLayout>


            <!-- Card Cuoc Hen -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="10dp">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_user"
                            android:padding="10dp"/>

                        <LinearLayout
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="Dr. Nguyen Van A"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:layout_height="26dp"
                                android:layout_width="300dp"/>

                            <TextView
                                android:text="Khoa tim mạch"
                                android:layout_marginTop="5dp"
                                android:layout_height="20dp"
                                android:layout_width="100dp"/>
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="10dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_calendar"
                            android:layout_marginStart="10dp"/>

                        <TextView
                            android:text="Thứ 4, ngày 4 tháng 3, 2026 - 10:30"
                            android:textSize="18sp"
                            android:layout_height="26dp"
                            android:layout_width="300dp"
                            android:layout_marginStart="10dp"/>

                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_view_appointment_detail"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:text="Xem chi tiết"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#A7C7E7"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- Dich Vu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:text="Dịch vụ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/all_dv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:background="@android:color/transparent"
                    android:textColor="#000000"/>
            </LinearLayout>


            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="10dp"
                android:alignmentMode="alignMargins">

                <!-- Service 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_service"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:layout_marginTop="5dp"
                        android:text="Tổng quát"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>

                <!-- Service 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_obstetrics"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:layout_marginTop="5dp"
                        android:text="Phụ sản"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>

                <!-- Service 3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_pediatrics"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:layout_marginTop="5dp"
                        android:text="Nhi"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>

                <!-- Service 4 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_psychology"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:layout_marginTop="5dp"
                        android:text="Thần kinh"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>

            </GridLayout>


            <!-- Bac Si -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:text="Bác sĩ"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/all_bs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:background="@android:color/transparent"
                    android:textColor="#000000"/>
            </LinearLayout>


            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="10dp">

                <!-- Doctor 1 -->
                <LinearLayout
                    android:id="@+id/ll_doctor_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/doctor"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:id="@+id/tv_doctor_name_1"
                        android:layout_marginTop="5dp"
                        android:text="BS.A"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>


                <!-- Doctor 2 -->
                <LinearLayout
                    android:id="@+id/ll_doctor_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/doctor"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:id="@+id/tv_doctor_name_2"
                        android:layout_marginTop="5dp"
                        android:text="BS.B"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>


                <!-- Doctor 3 -->
                <LinearLayout
                    android:id="@+id/ll_doctor_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/doctor"/>

                    <TextView
                        android:id="@+id/tv_doctor_name_3"
                        android:layout_marginTop="5dp"
                        android:text="BS.C"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>


                <!-- Doctor 4 -->
                <LinearLayout
                    android:id="@+id/ll_doctor_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_margin="6dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/doctor"/>

                    <TextView
                        android:id="@+id/tv_doctor_name_4"
                        android:layout_marginTop="5dp"
                        android:text="BS.D"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"/>
                </LinearLayout>

            </GridLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ================= BOTTOM NAV ================= -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/home_menu_bottom"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_color"
        app:itemTextColor="@color/nav_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>


