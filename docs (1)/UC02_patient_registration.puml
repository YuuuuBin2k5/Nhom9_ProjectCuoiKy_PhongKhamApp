@startuml UC02
title UC02: Bệnh nhân đăng ký tài khoản

left to right direction
skinparam packageStyle rectangle

actor "Bệnh nhân" as P

rectangle "Hệ thống Đăng ký" {
    usecase "Đăng ký tài khoản" as UC02
    usecase "Xác thực thông tin hợp lệ" as Validate
    usecase "Tạo tài khoản bệnh nhân" as CreateAccount
    usecase "Sinh mã QR định danh" as GenerateQR
    usecase "Tự động đăng nhập" as AutoLogin

    UC02 ..> Validate : <<include>>
    UC02 ..> CreateAccount : <<include>>
    CreateAccount ..> GenerateQR : <<include>>
    CreateAccount ..> AutoLogin : <<include>>
}

P --> UC02

note right of CreateAccount
  Tài khoản được kích hoạt (Active = true)
end note

@enduml