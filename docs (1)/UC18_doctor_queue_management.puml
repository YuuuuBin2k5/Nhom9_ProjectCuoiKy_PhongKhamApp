@startuml UC18
title UC18: Bác sĩ xử lý bệnh nhân trong hàng đợi

left to right direction
skinparam actorStyle awesome

actor "Bác sĩ" as D

rectangle "Hệ thống Quản lý Phòng khám" {
    usecase "Xử lý bệnh nhân trong hàng đợi" as UC18
    usecase "Khai thác bệnh án (QR/Mã)" as UC19
    usecase "Ghi nhận kết quả & chẩn đoán" as UC21
    usecase "Chuyển sang bước điều trị tiếp theo" as NextStep

    ' Bắt buộc: phải xác định bệnh nhân & xem hồ sơ
    UC18 ..> UC19 : <<include>>

    ' Bắt buộc: sau khi khám phải ghi nhận kết quả
    UC18 ..> UC21 : <<include>>

    ' Sau khi có kết quả thì chuyển step (rời queue hiện tại)
    UC21 ..> NextStep : <<include>>
}

D --> UC18

@enduml