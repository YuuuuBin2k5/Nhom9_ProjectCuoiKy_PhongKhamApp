@startuml UC13
title UC13: Bệnh nhân check-in xác nhận hiện diện

left to right direction
skinparam actorStyle awesome

actor "Bệnh nhân" as P

rectangle "Hệ thống Quản lý Phòng khám" {
    usecase "Check-in xác nhận hiện diện" as UC13
    usecase "Đăng nhập" as Login
    usecase "Quét mã QR" as ScanQR
    usecase "Nhập mã lịch hẹn" as InputCode
    usecase "Xem trạng thái hàng đợi" as ViewStatus

    UC13 ..> Login : <<include>>

    ScanQR ..> UC13 : <<extend>>
    InputCode ..> UC13 : <<extend>>
}

P --> UC13
P --> ViewStatus

@enduml