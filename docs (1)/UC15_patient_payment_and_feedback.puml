@startuml UC15
title UC15: Bệnh nhân thanh toán & đánh giá

left to right direction
skinparam actorStyle awesome

actor "Bệnh nhân" as P

rectangle "Hệ thống Quản lý Phòng khám" {
    usecase "Thanh toán" as UC15
    usecase "Xem chi tiết hóa đơn" as ViewInvoice
    usecase "Xác nhận thanh toán" as ConfirmPay
    usecase "Gửi đánh giá dịch vụ" as SubmitFeedback

    UC15 ..> ViewInvoice : <<include>>
    UC15 ..> ConfirmPay : <<include>>
    SubmitFeedback ..> UC15 : <<extend>>
}

P --> UC15

@enduml