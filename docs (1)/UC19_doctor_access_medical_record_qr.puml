@startuml UC19
title UC19: Bác sĩ Khai thác bệnh án qua mã QR (Medical Record Access via QR)

left to right direction
skinparam actorStyle awesome

actor "Bác sĩ" as D

rectangle "Hệ thống Quản lý Phòng khám" {
    usecase "Khai thác bệnh án qua QR" as UC19
    usecase "Quét mã QR bệnh nhân" as ScanQR
    usecase "Xem thông tin tóm tắt & Lịch hẹn" as ViewSummary
    usecase "Xem lịch sử hồ sơ bệnh án" as ViewHistory
    
    UC19 ..> ScanQR : <<include>>
    UC19 ..> ViewSummary : <<include>>
    ViewSummary ..> ViewHistory : <<extend>>
}

D --> UC19

@enduml
