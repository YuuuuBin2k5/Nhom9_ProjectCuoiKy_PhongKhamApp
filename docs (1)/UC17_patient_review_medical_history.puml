@startuml UC17
title UC17: Bệnh nhân xem lại lịch sử khám

left to right direction
skinparam actorStyle awesome

actor "Bệnh nhân" as P

rectangle "Hệ thống Quản lý Phòng khám" {
    usecase "Xem lịch sử khám" as UC17
    usecase "Xem hồ sơ bệnh án" as ViewEMR
    usecase "Xem đơn thuốc" as ViewPrescription
    usecase "Xem tiến độ phác đồ" as ViewPlan
    usecase "Xem lịch sử hóa đơn" as ViewInvoice

    ' Các chức năng này là tùy chọn khi user tra cứu
    ViewEMR ..> UC17 : <<extend>>
    ViewPlan ..> UC17 : <<extend>>
    ViewInvoice ..> UC17 : <<extend>>

    ' Đơn thuốc là phần mở rộng của EMR
    ViewPrescription ..> ViewEMR : <<extend>>
}

P --> UC17

@enduml