@startuml AC12
title AC12: Đặt lịch khám (Appointment Booking)

|Bệnh nhân|
start
:Mở ứng dụng;
:Chọn **Dịch vụ** muốn đặt;
:Chọn **Bác sĩ** (hoặc để hệ thống tự gán);
:Chọn **Ngày giờ** khám;
:Xác nhận thông tin đặt lịch;

|Hệ thống|
:Nhận yêu cầu đặt lịch;
:Xác thực Patient, Service, Doctor;

if (Dữ liệu hợp lệ?) then (Không)
  :Trả về lỗi\n(thiếu thông tin hoặc không tìm thấy);
  |Bệnh nhân|
  :Nhận thông báo lỗi;
  stop
else (Có)
endif

if (Doctor ID == null?) then (Có)
  :Tự động gán bác sĩ\ntheo chuyên khoa phù hợp;
else (Không)
  :Sử dụng bác sĩ đã chọn;
endif

:Kiểm tra thời gian\n(08:00 - 16:40);

if (Giờ hợp lệ?) then (Không)
  :Trả về lỗi\n"Thời gian ngoài giờ làm việc";
  |Bệnh nhân|
  :Nhận thông báo lỗi;
  stop
else (Có)
endif

:Kiểm tra lịch trùng\ncủa bệnh nhân;

if (Đã có lịch chưa hoàn thành?) then (Có)
  :Trả về lỗi\n"Đang có lịch chưa hoàn thành";
  |Bệnh nhân|
  :Nhận thông báo lỗi;
  stop
else (Không)
endif

:Kiểm tra lịch trùng\ncủa bác sĩ (±30 phút);

if (Bác sĩ bận?) then (Có)
  :Trả về lỗi\n"Bác sĩ đã có lịch trong khung giờ này";
  |Bệnh nhân|
  :Nhận thông báo lỗi;
  stop
else (Không)
endif

:Tạo Appointment\n(Status: SCHEDULED, Type: ONLINE);
:Lưu vào cơ sở dữ liệu;

|Bệnh nhân|
:Nhận xác nhận đặt lịch thành công\n(Tên dịch vụ, Bác sĩ, Ngày giờ);

stop
@enduml
