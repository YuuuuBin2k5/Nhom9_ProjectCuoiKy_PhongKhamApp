@startuml UC16
title UC16: Bệnh nhân tra cứu dịch vụ & đánh giá

left to right direction
skinparam actorStyle awesome

actor "Bệnh nhân" as P

rectangle "Hệ thống Quản lý Phòng khám" {
    usecase "Tra cứu dịch vụ" as UC16
    usecase "Xem danh sách theo danh mục" as ViewByCategory
    usecase "Xem chi tiết dịch vụ" as ViewServiceDetail
    usecase "Xem đánh giá" as ViewReviews
    usecase "Tìm kiếm dịch vụ" as SearchService

    UC16 ..> ViewByCategory : <<include>>

    ' Chi tiết là hành vi người dùng có thể chọn
    ViewServiceDetail ..> UC16 : <<extend>>

    ' Khi xem chi tiết thì hiển thị đánh giá
    ViewServiceDetail ..> ViewReviews : <<include>>

    ' Tìm kiếm là tùy chọn
    SearchService ..> UC16 : <<extend>>
}

P --> UC16

@enduml