@startuml UC12
title UC12: Bệnh nhân đặt lịch khám (Patient Book Appointment)

left to right direction
skinparam actorStyle awesome

actor "Bệnh nhân" as P

rectangle "Hệ thống Quản lý Phòng khám" {
    usecase "Đăng nhập" as Login
    usecase "Tra cứu Danh mục & Dịch vụ" as UC_Search
    usecase "Chọn Bác sĩ mong muốn" as UC_Doctor
    usecase "Đặt lịch khám" as UC12

    ' Quan hệ: Phải đăng nhập để đặt lịch
    UC12 ..> Login : <<include>>
    
    ' Quan hệ: Tra cứu dịch vụ là một phần của quy trình đặt lịch
    UC12 ..> UC_Search : <<include>>
    
    ' Quan hệ: Chọn bác sĩ là tùy chọn mở rộng
    UC_Doctor ..> UC12 : <<extend>>
}

P --> UC12
P --> UC_Search

@enduml
