@startuml UC01
title UC01: Đăng nhập hệ thống

left to right direction
skinparam packageStyle rectangle

actor "Bệnh nhân" as P
actor "Bác sĩ" as D
actor "Quản trị viên" as A

rectangle "Hệ thống Xác thực" {
    usecase "Đăng nhập" as Login
    usecase "Làm mới phiên (Refresh Token)" as Refresh
    usecase "Xác thực tài khoản hợp lệ" as ValidateAccount

    Login ..> ValidateAccount : <<include>>
    Refresh ..> ValidateAccount : <<include>>
}

P --> Login
P --> Refresh

D --> Login
D --> Refresh

A --> Login
A --> Refresh

@enduml