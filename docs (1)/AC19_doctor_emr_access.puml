@startuml AC19
title AC19: Khai thác bệnh án qua mã QR (EMR Access via QR)

|Bác sĩ|
start
:Mở tính năng **Quét QR**\nhoặc nhập mã thủ công;

if (Quét QR bằng camera?) then (Có)
  :Hướng camera vào mã QR\ncủa bệnh nhân;
  :Nhận QR data tự động;
else (Không)
  :Nhập mã bệnh nhân thủ công;
endif

|Hệ thống|
:Gọi API GET /api/doctor/patient?qr=...;
:Giải mã QR data;

if (Loại QR) then (JWT)
  :Parse JWT -> lấy patientId\ntừ subject;
elseif (Loại QR) then (CHECKIN:ID)
  :Tìm Appointment -> lấy patientId;
elseif (Loại QR) then (patient:ID)
  :Parse trực tiếp patientId;
else (Numeric)
  :Thử tìm Appointment hoặc Patient\ntheo ID;
endif

if (Tìm thấy bệnh nhân?) then (Không)
  |Bác sĩ|
  :Nhận lỗi "Không tìm thấy bệnh nhân";
  stop
else (Có)
endif

:Truy vấn thông tin bệnh nhân\n(Tên, SĐT, Email);
:Truy vấn Appointment hôm nay\n(Dịch vụ, Trạng thái, Queue ID);
:Trả về PatientInfo;

|Bác sĩ|
:Hiển thị thông tin tóm tắt bệnh nhân\n(Tên, Dịch vụ đã đặt, Trạng thái);

if (Muốn xem lịch sử?) then (Có)
  :Nhấn **Xem lịch sử hồ sơ**;
  
  |Hệ thống|
  :Tải danh sách Medical Records\ncủa bệnh nhân;
  
  |Bác sĩ|
  :Xem lịch sử khám\n(Bottom Sheet: Chẩn đoán cũ, Đơn thuốc);
else (Không)
endif

:Sẵn sàng bắt đầu thăm khám;

stop
@enduml
