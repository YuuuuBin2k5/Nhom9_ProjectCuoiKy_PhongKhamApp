@startuml AC21
title AC21: Ghi nhận kết quả & Chẩn đoán (Diagnosis & Results)

|Bác sĩ|
start
:Đang trong phiên khám\n(sau UC18/UC19);

:Chọn form thăm khám phù hợp\n(Tổng quát / Phẫu thuật / Chỉnh nha);

if (Loại form?) then (Tổng quát)
  :Nhập lý do khám;
  :Nhập chẩn đoán;
  :Chọn răng và ghi nhận\nđiều trị cho từng răng;
elseif (Loại form?) then (Phẫu thuật)
  :Điền checklist phẫu thuật;
  :Ghi nhận ghi chú phẫu thuật;
else (Chỉnh nha)
  :Điền form chỉnh nha;
  :Ghi nhận tình trạng;
endif

if (Cần tải ảnh kết quả?) then (Có)
  :Chụp/chọn ảnh X-quang\nhoặc ảnh lâm sàng;
  
  |Hệ thống|
  :Upload ảnh lên server;
  :Đính kèm vào hồ sơ;
  
  |Bác sĩ|
else (Không)
endif

if (Cần kê đơn thuốc?) then (Có)
  :Nhấn **Kê đơn thuốc**;
  :Nhập danh sách thuốc\n(Tên, Liều, Tần suất, Thời gian, Đơn vị);
  
  |Hệ thống|
  :Gọi API POST /api/prescriptions;
  :Gửi {appointmentId, diagnosis,\nsymptoms, advice, details[]};
  :Tạo/Cập nhật MedicalRecord;
  :Tạo Prescription + PrescriptionDetails;
  :Liên kết Prescription <-> MedicalRecord;
  
  |Bác sĩ|
  :Nhận xác nhận "Đã lưu đơn thuốc";
else (Không)
endif

:Nhấn **Hoàn thành bước điều trị**;

|Hệ thống|
:Gọi API PATCH /api/treatment-plans/steps/{id}/complete;
:Gửi {doctorConclusion: kết luận};

:Kiểm tra quyền bác sĩ\n(phòng hiện tại == phòng của step?);

if (Có quyền?) then (Không)
  |Bác sĩ|
  :Nhận lỗi "Không có quyền\nhoàn thành bước này";
  stop
else (Có)
endif

:Cập nhật step status -> COMPLETED;
:Ghi nhận doctorConclusion;

if (Còn step tiếp theo?) then (Có)
  :Xác định phòng tiếp theo;
  :Thêm bệnh nhân vào\nhàng đợi phòng mới;
  :Gửi thông báo cho bệnh nhân\n"Di chuyển đến phòng X";
  
  |Bác sĩ|
  :Hiển thị thông báo\n"Bệnh nhân cần chuyển sang {roomName}";
else (Không - Hoàn thành phác đồ)
  :Cập nhật TreatmentPlan\nstatus -> COMPLETED;
  
  |Bác sĩ|
  :Hiển thị "Hoàn tất bước khám";
endif

stop
@enduml
